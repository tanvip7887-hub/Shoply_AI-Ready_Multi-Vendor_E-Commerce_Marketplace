generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                      @id @default(autoincrement())
  name                 String
  email                String                   @unique
  password             String
  role                 Role                     @default(CUSTOMER)
  isEmailVerified      Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  avatar               String?
  phone                String?
  status               UserStatus               @default(ACTIVE)
  dateOfBirth          DateTime?
  gender               Gender?
  addresses            Address[]
  auditLogs            AuditLog[]
  cart                 Cart?
  emailVerifications   EmailVerificationToken[]
  inventoryUpdates     InventoryHistory[]
  notifications        Notification[]
  orders               Order[]
  passwordResets       PasswordResetToken[]
  refreshTokens        RefreshToken[]
  reviewedApplications SellerApplication[]      @relation("ApplicationReviewer")
  sellerApplications   SellerApplication[]
  seller               Seller?
  wishlists            Wishlist[]
  assignedShipments            Shipment[]                   @relation("AgentShipments")
  deliveryPartnerApplications  DeliveryPartnerApplication[] @relation("DeliveryApplicant")
  reviewedDeliveryApplications DeliveryPartnerApplication[] @relation("DeliveryApplicationReviewer")
  reviews                      Review[]
  returnRequests               ReturnRequest[]
  agentReturnShipments         ReturnShipment[]             @relation("AgentReturnShipments")

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_userId_fkey")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_userId_fkey")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "email_verification_tokens_userId_fkey")
  @@map("email_verification_tokens")
}

model Address {
  id           Int         @id @default(autoincrement())
  userId       Int
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  country      String      @default("India")
  type         AddressType @default(HOME)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "addresses_userId_fkey")
  @@map("addresses")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  image       String?
  isActive    Boolean    @default(true)
  parentId    Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryToSubcategories", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToSubcategories")
  products    Product[]

  @@index([parentId], map: "categories_parentId_fkey")
  @@map("categories")
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Product {
  id              Int                   @id @default(autoincrement())
  sellerId        Int
  categoryId      Int
  brandId         Int?
  name            String
  slug            String                @unique
  description     String?               @db.Text
  price           Decimal               @db.Decimal(10, 2)
  discountPrice   Decimal?              @db.Decimal(10, 2)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  isDeleted       Boolean               @default(false)
  height          Decimal?              @db.Decimal(8, 2)
  length          Decimal?              @db.Decimal(8, 2)
  sku             String?               @unique
  weight          Decimal?              @db.Decimal(8, 2)
  width           Decimal?              @db.Decimal(8, 2)
  approvalStatus  ProductApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      Int?
  rejectedAt      DateTime?
  rejectedBy      Int?
  rejectionReason String?
  cartItems       CartItem[]
  inventory       Inventory?
  orderItems      OrderItem[]
  images          ProductImage[]
  brand           Brand?                @relation(fields: [brandId], references: [id])
  category        Category              @relation(fields: [categoryId], references: [id])
  seller          Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  wishlistedBy    Wishlist[]
  reviews         Review[]
  returnRequests  ReturnRequest[]

  @@index([brandId], map: "products_brandId_fkey")
  @@index([categoryId], map: "products_categoryId_fkey")
  @@index([sellerId], map: "products_sellerId_fkey")
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  createdAt DateTime @default(now())
  publicId  String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "product_images_productId_fkey")
  @@map("product_images")
}

model Inventory {
  id                Int                @id @default(autoincrement())
  productId         Int                @unique
  stock             Int                @default(0)
  reservedStock     Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  availableStock    Int                @default(0)
  lowStockThreshold Int                @default(5)
  status            InventoryStatus    @default(OUT_OF_STOCK)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  history           InventoryHistory[]

  @@map("inventories")
}

model InventoryHistory {
  id             Int                    @id @default(autoincrement())
  inventoryId    Int
  quantityChange Int
  reason         InventoryHistoryReason
  notes          String?                @db.Text
  previousStock  Int
  newStock       Int
  updatedById    Int
  createdAt      DateTime               @default(now())
  inventory      Inventory              @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  updatedBy      User                   @relation(fields: [updatedById], references: [id])

  @@index([inventoryId], map: "inventory_history_inventoryId_fkey")
  @@index([updatedById], map: "inventory_history_updatedById_fkey")
  @@map("inventory_history")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId], map: "cart_items_productId_fkey")
  @@map("cart_items")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId], map: "wishlists_productId_fkey")
  @@map("wishlists")
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int
  sellerId        Int
  shippingAddress Json
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCharge  Decimal       @default(0.00) @db.Decimal(10, 2)
  discount        Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?
  paidAt           DateTime?
  orderStatus      OrderStatus   @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items           OrderItem[]
  seller          Seller        @relation(fields: [sellerId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  shipment        Shipment?
  reviews         Review[]
  returnRequests  ReturnRequest[]

  @@index([sellerId], map: "orders_sellerId_fkey")
  @@index([userId], map: "orders_userId_fkey")
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  review      Review?
  returnRequest ReturnRequest?

  @@index([orderId], map: "order_items_orderId_fkey")
  @@index([productId], map: "order_items_productId_fkey")
  @@map("order_items")
}

model SellerAddress {
  id           Int                @id @default(autoincrement())
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String             @default("India")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  application  SellerApplication?
  seller       Seller?

  @@map("seller_addresses")
}

model SellerApplication {
  id                  Int               @id @default(autoincrement())
  userId              Int
  businessName        String
  ownerName           String
  mobileNumber        String
  businessType        BusinessType
  gstNumber           String?
  panNumber           String?
  sellerAddressId     Int               @unique
  businessDescription String?
  status              ApplicationStatus @default(DRAFT)
  rejectionReason     String?
  reviewedByAdminId   Int?
  reviewedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  reviewedByAdmin     User?             @relation("ApplicationReviewer", fields: [reviewedByAdminId], references: [id])
  sellerAddress       SellerAddress     @relation(fields: [sellerAddressId], references: [id])
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           SellerDocument[]
  seller              Seller?

  @@index([reviewedByAdminId], map: "seller_applications_reviewedByAdminId_fkey")
  @@index([userId], map: "seller_applications_userId_fkey")
  @@map("seller_applications")
}

model SellerDocument {
  id            Int               @id @default(autoincrement())
  applicationId Int
  type          DocumentType
  fileUrl       String
  uploadedAt    DateTime          @default(now())
  application   SellerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "seller_documents_applicationId_fkey")
  @@map("seller_documents")
}

model Seller {
  id                  Int                @id @default(autoincrement())
  userId              Int                @unique
  gstNumber           String?
  panNumber           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  status              SellerStatus       @default(VERIFIED)
  applicationId       Int                @unique
  businessDescription String?
  businessName        String
  isPayoutSetup       Boolean            @default(false)
  mobileNumber        String
  ownerName           String
  sellerAddressId     Int                @unique
  sellerCode          String             @unique
  avatar              String?
  displayName         String?
  orders              Order[]
  products            Product[]
  returnRequests      ReturnRequest[]
  bankAccount         SellerBankAccount?
  application         SellerApplication  @relation(fields: [applicationId], references: [id])
  sellerAddress       SellerAddress      @relation(fields: [sellerAddressId], references: [id])
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sellers")
}

model SellerBankAccount {
  id                     Int      @id @default(autoincrement())
  sellerId               Int      @unique
  accountHolderName      String
  accountNumberEncrypted String
  accountLastFour        String
  ifscCode               String
  bankName               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  isVerified             Boolean  @default(false)
  seller                 Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_bank_accounts")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String
  entityId   Int
  entityType String
  details    Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "audit_logs_adminId_fkey")
  @@map("audit_logs")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
  DELIVERY_AGENT
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum InventoryHistoryReason {
  INITIAL_STOCK
  RESTOCK
  MANUAL_ADJUSTMENT
  ORDER_DEDUCTION
  ORDER_CANCELLATION
  RETURNED_ITEMS
  DAMAGED_ITEMS
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  PICKUP_CREATED
  OUT_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  GST_CERTIFICATE
  PAN_CARD
  ADDRESS_PROOF
  CANCELLED_CHEQUE
  OTHER
}

enum SellerStatus {
  VERIFIED
  SUSPENDED
}

enum BusinessType {
  INDIVIDUAL
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ShipmentStatus {
  PICKUP_CREATED
  OUT_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model Shipment {
  id              Int            @id @default(autoincrement())
  orderId         Int            @unique
  deliveryAgentId Int?
  trackingNumber  String         @unique
  shipmentStatus  ShipmentStatus @default(PICKUP_CREATED)
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryAgent   User?          @relation("AgentShipments", fields: [deliveryAgentId], references: [id])

  @@index([deliveryAgentId], map: "shipments_deliveryAgentId_fkey")
  @@map("shipments")
}

model DeliveryPartnerApplication {
  id                Int               @id @default(autoincrement())
  userId            Int
  phone             String
  vehicleType       String?
  city              String?
  status            ApplicationStatus @default(PENDING)
  rejectionReason   String?
  reviewedByAdminId Int?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation("DeliveryApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin   User?             @relation("DeliveryApplicationReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([userId], map: "delivery_partner_applications_userId_fkey")
  @@index([reviewedByAdminId], map: "delivery_partner_applications_reviewedByAdminId_fkey")
  @@map("delivery_partner_applications")
}

model Review {
  id          Int       @id @default(autoincrement())
  userId      Int
  productId   Int
  orderId     Int
  orderItemId Int       @unique
  rating      Int
  comment     String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orderItemId])
  @@index([orderId], map: "reviews_orderId_fkey")
  @@index([productId], map: "reviews_productId_fkey")
  @@index([userId], map: "reviews_userId_fkey")
  @@map("reviews")
}

enum ReturnStatus {
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  INSPECTION
  REFUND_INITIATED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  PENDING
  INITIATED
  COMPLETED
  FAILED
}

enum ReturnReason {
  DAMAGED_PRODUCT
  WRONG_PRODUCT
  SIZE_FIT_ISSUE
  NOT_AS_EXPECTED
  MISSING_ITEM
  OTHER
}

model ReturnRequest {
  id                Int            @id @default(autoincrement())
  orderItemId       Int            @unique
  orderId           Int
  customerId        Int
  sellerId          Int
  productId         Int
  reason            ReturnReason
  comment           String?        @db.Text
  status            ReturnStatus   @default(RETURN_REQUESTED)
  rejectionReason   String?        @db.Text
  refundAmount      Decimal        @db.Decimal(10, 2)
  requestedAt       DateTime       @default(now())
  approvedAt        DateTime?
  rejectedAt        DateTime?
  pickupScheduledAt DateTime?
  pickedUpAt        DateTime?
  receivedAt        DateTime?
  inspectedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orderItem         OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer          User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller            Seller         @relation(fields: [sellerId], references: [id])
  product           Product        @relation(fields: [productId], references: [id])
  refund            Refund?
  returnShipment    ReturnShipment?

  @@index([orderId], map: "return_requests_orderId_fkey")
  @@index([customerId], map: "return_requests_customerId_fkey")
  @@index([sellerId], map: "return_requests_sellerId_fkey")
  @@index([productId], map: "return_requests_productId_fkey")
  @@map("return_requests")
}

model Refund {
  id                   Int           @id @default(autoincrement())
  returnRequestId      Int           @unique
  amount               Decimal       @db.Decimal(10, 2)
  status               RefundStatus  @default(PENDING)
  paymentMethod        PaymentMethod
  transactionReference String?
  initiatedAt          DateTime?
  completedAt          DateTime?
  failureReason        String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  returnRequest        ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model ReturnShipment {
  id              Int            @id @default(autoincrement())
  returnRequestId Int            @unique
  deliveryAgentId Int?
  trackingNumber  String         @unique
  shipmentStatus  ShipmentStatus @default(PICKUP_CREATED)
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  returnRequest   ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  deliveryAgent   User?          @relation("AgentReturnShipments", fields: [deliveryAgentId], references: [id])

  @@index([deliveryAgentId], map: "return_shipments_deliveryAgentId_fkey")
  @@map("return_shipments")
}

